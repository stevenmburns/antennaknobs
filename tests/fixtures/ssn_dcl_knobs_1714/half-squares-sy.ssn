                   </escapeHatch>
                   <p>
                       <n>equ</n>
                       <v>//Half-Square
//4nec2\models\HFvertical\80HSBEAM.NEC
P1 p1a gnd;  // load side, not used
P2 p2a gnd;  // generator side

NECUnits meters;
NECOptions.mhosPerMeter = 5.747e7;  // from LD 5 card in NEC deck (copper)
NECOptions.fieldStep = 2;
NECOptions.segmentsPerWavelength = 36;  // to yield ~same as NEC deck, 88 segments

// Variables as set via 4nec2 &quot;SY&quot; cards.
// General instructions for importing 4nec2 files:
//	1) Copy the complete 4nec2 file into a temporary Notepad file.
//	2) If necessary, group all SY cards together.  (May be mixed in with GW cards.)
//	3) For all SY cards, replace all &quot;SY&quot; with &quot;dcl&quot;, replace all &quot;&apos;&quot; (single quote comment
//		marker) with &quot;; // &quot; or if no trailing comment just append a semi-colon, convert
// 		any suffix unit qualifers, copy all such modified rows and paste above the
//		NEC2 keyword, then delete those rows from the Notepad file.
//	4) For the remaining &quot;non SY&quot; rows, replace all &quot;&apos;&quot; (single quote) with &quot;//&quot;, convert
//		any suffix unit qualifers, then copy/paste between the NEC2/NECEND keywords.

dcl dy = 12.678;  // original SY card name was dY but SimNEC variables are case sensitive
dcl hgh = 31.0444;
dcl rad=.00103;
dcl len = 42.22;
dcl sln=21.607;
dcl Xc=50;
dcl Cu=5.747e7;

NEC2  // ====================
CM 80hsbeam.nec, Half-Square Parasitic beam by L.B. Cebik
CM Fixed values replaced by variables for optimization.
CE
GW	1	11	-len/2	0.	hgh-sln	-len/2	0.	hgh	rad
GW	2	22	-len/2	0.	hgh	len/2	0.	hgh	rad
GW	3	11	len/2	0.	hgh	len/2	0.	hgh-sln	rad
GW	4	11	-len/2	-dy	hgh-sln	-len/2	-dy	hgh	rad
GW	5	22	-len/2	-dy	hgh	len/2	-dy	hgh	rad
GW	6	11	len/2	-dy	hgh	len/2	-dy	hgh-sln	rad
GE	1
LD	4	4	11	11	0.	Xc
LD	5	0	0	0	Cu
FR	0	1	0	0	3.51	
GN	2	0	0	0	13.	 .005
EX	0	1	11	0	1	0
EX	0	2	1	0	1	0
EN
NECEND  // ====================

// For loads, if any, use info from above.  L values are uH, C values are pF.
// The N block &quot;R&quot; component can be a real, imaginary, or complex impedance.
// NECWires from &quot;GW&quot; cards are automatically named $GW_1, $GW_2, etc.
// The above LD4 load is placed at seg position 10.5 out of 11 or 95.45%.
dcl R_4 = 0+j50;
R4 (R_4) r4a r4b;
dcl Load4 = NECSource({r4a,r4b}, $GW_4, 95.45);

// Set G.MHz based on FR card above.
// If not free space, modify/use one of the ground choices below.
SommerfeldGround(0.005, 13);  // from GN 2 card above; note reverse order
//MiniNECGround(0.005, 13);  // example
//PerfectGround();
// Show the number of segments at final freq G.MHz.
// For each wire in the model, the _NECBLOCK.wires.currents array is size n segments.
at(finalValue) {
	SegCnt = 0;
	for($i=0; $i&lt;SizeOf(Antenna._NECBLOCK.wires); $i++)
		SegCnt = SegCnt + SizeOf(Antenna._NECBLOCK.wires[$i].currents);
}

BodyGraphic(antenna);
BodyGraphic(&#x201c;Half-Square&#x201d;, 0.12, 0.5, 0.75, 4);
BodyGraphic(&#x201c;Parasitic Beam&#x201d;, 0.12, 0.5, 0.90, 4);</v>
