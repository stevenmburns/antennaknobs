               <element>
                   <type>NETWORK</type>
                   <sweeperLabel>Antenna</sweeperLabel>
                   <fromFile>
                       <powerFormat>0</powerFormat>
                       <voltageFormat>0</voltageFormat>
                       <rotationCount>0</rotationCount>
                       <flipped>false</flipped>
                   </fromFile>
