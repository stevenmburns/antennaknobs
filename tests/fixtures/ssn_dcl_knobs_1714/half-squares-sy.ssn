                   <p>
                       <n>Plt</n>
                       <v>//Plots
// Show Max Gain at az/el and Front/Back ratio only at(finalValue), not during a sweep.
String MaxGain;  String at_;  String Fr_Bk;
at(finalValue) {
	dcl maxdBi = Antenna._NECBLOCK.field.max.dBi;
	MaxGain = maxdBi+&quot; dBi&quot;;
	dcl maxdir = Antenna._NECBLOCK.field.max.dir;  // returned as complex (azimuth &#xb1;j elevation)
	at_ = &quot;az &quot; + maxdir.R + &quot;   &quot; + &quot;el &quot; + maxdir.X;
	dcl backdBi = Antenna._NECBLOCK.field.back.dBi;
	Fr_Bk = (maxdBi - backdBi)+&quot; dB&quot;;
}

// Plot Tot dBi, Horz dBi, Vert dBi for azimuth slice (setElev) or elevation slice (setAzim).
setAzim;  setElev;
dcl dBi = Max(Antenna._NECBLOCK.field.GetFieldAt(setAzim, setElev).dBi, -50);  // clip dBi at -50
dcl HdBi = Max(Antenna._NECBLOCK.field.GetFieldAt(setAzim, setElev).Hor_dBi, -50);  // clip dBi at -50
dcl VdBi = Max(Antenna._NECBLOCK.field.GetFieldAt(setAzim, setElev).Ver_dBi, -50);  // clip dBi at -50
Plot(Stroke(3), RGBA(1,0,0,1), &quot;Tot dBi (y1)&quot;, dBi, y1);
Plot(Stroke(3,5,5), RGBA(0,0,1,1), &quot;Horz dBi (y1)&quot;, HdBi, y1);
Plot(Stroke(3,5,5), RGBA(0,0.8,0,1), &quot;Vert dBi (y1)&quot;, VdBi, y1);</v>
                       <fontScale>1.4071004226562505</fontScale>
