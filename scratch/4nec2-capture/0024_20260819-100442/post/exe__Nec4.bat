@echo off
rem	Batch file for handling 4nec2 v5.2 in/output files using a
rem	Nec4 based engine.
rem
rem	This (empty) batch file can be used to run user specific actions.
rem
rem	Use 'settings -> Nec engine -> Wait in DOS box' to let 4nec2
rem	call this batch file (while having enabled the Nec4 engine).
rem
rem	
rem	%1	file name of nec input-file (*.inp) in ..\out folder
