                   <escapeHatch/>
                   <p>
                       <n>equ</n>
                       <v>//Three-wire inverted V for 20 m
// A short feed wire at the apex and two drooping legs.
// Leaf constants (knobs in antennaknobs): gap, length_factor, angle.
P1 w1 gnd;
P2 w2 gnd;

SommerfeldGround(0.005, 13);

dcl gap = 0.2;            // Feed-wire length at the apex (m)
dcl length_factor = 0.96; // Each leg as a fraction of a quarter wave
dcl angle = 30;           // Leg droop below horizontal (degrees)
dcl leg = length_factor*299.792458/14.2/4 - gap/2;  // Leg length (m)
dcl dy = leg*Cos(angle*Pi/180);  // SimNEC trig is in radians
dcl dz = leg*Sin(angle*Pi/180);
dcl yend = gap/2 + dy;   // Leg end, across (m)
dcl zend = 12 - dz;      // Leg end, height (m)

NEC2
CM Three-wire inverted V for 20 m
CE
GW 1 1  0 -gap/2 12  0 gap/2 12  0.001
GW 2 25 0 gap/2 12  0 yend zend  0.001
GW 3 25 0 -gap/2 12  0 -yend zend  0.001
GE 1
EX 0 1 1 0 1 0
EN
NECEND
$GW_1.JamSegments(1);
$GW_2.JamSegments(25);
$GW_3.JamSegments(25);
</v>
                       <fontScale>1.2155062500000002</fontScale>
                       <w>645</w>
                       <h>625</h>
